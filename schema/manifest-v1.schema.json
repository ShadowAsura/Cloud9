{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cloud 9 manifest v1",
  "type": "object",
  "required": [
    "schema_version",
    "episode",
    "mode",
    "game",
    "mods",
    "map",
    "villagers",
    "center"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "episode": {
      "type": "object",
      "required": [
        "video_id",
        "title",
        "url",
        "upload_date",
        "duration",
        "thumbnail_path"
      ],
      "properties": {
        "video_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "upload_date": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "duration": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "thumbnail_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "thumbnail_url": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^https://"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "mode": {
      "allOf": [
        {
          "$ref": "#/$defs/evidence"
        },
        {
          "properties": {
            "value": {
              "enum": [
                "challenge_games",
                "lucky_block_bedwars"
              ]
            },
            "alternatives": {
              "items": {
                "properties": {
                  "value": {
                    "enum": [
                      "challenge_games",
                      "lucky_block_bedwars"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "game": {
      "type": "object",
      "required": [
        "mc_version",
        "loader",
        "java_major"
      ],
      "properties": {
        "mc_version": {
          "allOf": [
            {
              "$ref": "#/$defs/evidence"
            },
            {
              "properties": {
                "value": {
                  "type": "string"
                },
                "alternatives": {
                  "items": {
                    "properties": {
                      "value": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "loader": {
          "type": "object",
          "required": [
            "type",
            "version"
          ],
          "properties": {
            "type": {
              "allOf": [
                {
                  "$ref": "#/$defs/evidence"
                },
                {
                  "properties": {
                    "value": {
                      "type": "string"
                    },
                    "alternatives": {
                      "items": {
                        "properties": {
                          "value": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              ]
            },
            "version": {
              "allOf": [
                {
                  "$ref": "#/$defs/evidence"
                },
                {
                  "properties": {
                    "value": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "alternatives": {
                      "items": {
                        "properties": {
                          "value": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              ]
            }
          }
        },
        "java_major": {
          "allOf": [
            {
              "$ref": "#/$defs/evidence"
            },
            {
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "alternatives": {
                  "items": {
                    "properties": {
                      "value": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 1
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "mods": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "mod_id",
          "display_name",
          "aliases",
          "optional",
          "client_only"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "role": {
            "enum": [
              "lucky",
              "companion"
            ]
          },
          "mod_id": {
            "allOf": [
              {
                "$ref": "#/$defs/evidence"
              },
              {
                "properties": {
                  "value": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "alternatives": {
                    "items": {
                      "properties": {
                        "value": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      }
                    }
                  }
                }
              }
            ]
          },
          "display_name": {
            "allOf": [
              {
                "$ref": "#/$defs/evidence"
              },
              {
                "properties": {
                  "value": {
                    "type": "string"
                  },
                  "alternatives": {
                    "items": {
                      "properties": {
                        "value": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            ]
          },
          "version_range": {
            "allOf": [
              {
                "$ref": "#/$defs/evidence"
              },
              {
                "properties": {
                  "value": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "alternatives": {
                    "items": {
                      "properties": {
                        "value": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      }
                    }
                  }
                }
              }
            ]
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "file_hint": {
            "anyOf": [
              {
                "type": "object",
                "required": [],
                "properties": {
                  "filename": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-fA-F0-9]{64}$"
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^https://"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "optional": {
            "type": "boolean"
          },
          "client_only": {
            "type": "boolean"
          }
        }
      }
    },
    "map": {
      "type": "object",
      "required": [
        "template_id",
        "overrides"
      ],
      "properties": {
        "template_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "overrides": {
          "type": "object"
        }
      }
    },
    "villagers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "position",
          "trades"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "role": {
            "type": "string"
          },
          "position": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "integer"
            }
          },
          "trades": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "buy",
                "sell",
                "max_uses"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                },
                "buy": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "item",
                      "count"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                      },
                      "item": {
                        "type": "object",
                        "required": [
                          "raw_text"
                        ],
                        "properties": {
                          "id": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "legacy_id": {
                            "anyOf": [
                              {
                                "type": "integer",
                                "minimum": 0
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "meta": {
                            "anyOf": [
                              {
                                "type": "integer",
                                "minimum": 0
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "nbt": {
                            "anyOf": [
                              {
                                "type": "object"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "raw_text": {
                            "type": "string"
                          }
                        }
                      },
                      "count": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "nbt": {
                        "anyOf": [
                          {
                            "type": "object"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    }
                  },
                  "minItems": 1,
                  "maxItems": 1
                },
                "buy_b": {
                  "anyOf": [
                    {
                      "type": "object",
                      "required": [
                        "id",
                        "item",
                        "count"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                        },
                        "item": {
                          "type": "object",
                          "required": [
                            "raw_text"
                          ],
                          "properties": {
                            "id": {
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "legacy_id": {
                              "anyOf": [
                                {
                                  "type": "integer",
                                  "minimum": 0
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "meta": {
                              "anyOf": [
                                {
                                  "type": "integer",
                                  "minimum": 0
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "nbt": {
                              "anyOf": [
                                {
                                  "type": "object"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "raw_text": {
                              "type": "string"
                            }
                          }
                        },
                        "count": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "nbt": {
                          "anyOf": [
                            {
                              "type": "object"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "sell": {
                  "type": "object",
                  "required": [
                    "id",
                    "item",
                    "count"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                    },
                    "item": {
                      "type": "object",
                      "required": [
                        "raw_text"
                      ],
                      "properties": {
                        "id": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "legacy_id": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 0
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "meta": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 0
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "nbt": {
                          "anyOf": [
                            {
                              "type": "object"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "raw_text": {
                          "type": "string"
                        }
                      }
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "nbt": {
                      "anyOf": [
                        {
                          "type": "object"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                },
                "max_uses": {
                  "type": "integer",
                  "minimum": 1
                },
                "note": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "center": {
      "type": "object",
      "required": [
        "kind",
        "blocks",
        "chests",
        "generators"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "pos",
              "item"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              },
              "pos": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "integer"
                }
              },
              "item": {
                "type": "object",
                "required": [
                  "raw_text"
                ],
                "properties": {
                  "id": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "legacy_id": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "meta": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "nbt": {
                    "anyOf": [
                      {
                        "type": "object"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "raw_text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "chests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "pos",
              "slots"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              },
              "pos": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "integer"
                }
              },
              "slots": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "item",
                    "count",
                    "slot"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                    },
                    "item": {
                      "type": "object",
                      "required": [
                        "raw_text"
                      ],
                      "properties": {
                        "id": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "legacy_id": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 0
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "meta": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 0
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "nbt": {
                          "anyOf": [
                            {
                              "type": "object"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "raw_text": {
                          "type": "string"
                        }
                      }
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "nbt": {
                      "anyOf": [
                        {
                          "type": "object"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "slot": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 53
                    }
                  }
                }
              }
            }
          }
        },
        "generators": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "pos",
              "item",
              "interval_ticks"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              },
              "pos": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "integer"
                }
              },
              "item": {
                "type": "object",
                "required": [
                  "raw_text"
                ],
                "properties": {
                  "id": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "legacy_id": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "meta": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "nbt": {
                    "anyOf": [
                      {
                        "type": "object"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "raw_text": {
                    "type": "string"
                  }
                }
              },
              "interval_ticks": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "allow_multiple_lucky": {
      "type": "boolean"
    },
    "findings": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/evidence"
          },
          {
            "properties": {
              "value": {},
              "alternatives": {
                "items": {
                  "properties": {
                    "value": {}
                  }
                }
              }
            }
          }
        ],
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          }
        }
      }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "required": [
        "value",
        "confidence",
        "source"
      ],
      "properties": {
        "value": {},
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source": {
          "type": "string",
          "pattern": "^(description|chapter|comment|visual|manual|caption@[0-9]{2,}:[0-5][0-9])$"
        },
        "source_span": {
          "type": "string"
        },
        "timestamp_seconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "value",
        "confidence",
        "source",
        "status"
      ],
      "properties": {
        "value": {},
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source": {
          "type": "string",
          "pattern": "^(description|chapter|comment|visual|manual|caption@[0-9]{2,}:[0-5][0-9])$"
        },
        "source_span": {
          "type": "string"
        },
        "timestamp_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "auto",
            "needs_review",
            "confirmed",
            "overridden"
          ]
        },
        "defaulted": {
          "type": "boolean"
        },
        "alternatives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidate"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "visual"
              }
            }
          },
          "then": {
            "required": [
              "timestamp_seconds"
            ]
          }
        }
      ]
    }
  }
}
